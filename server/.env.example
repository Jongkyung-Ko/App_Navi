# Kakao Developers (https://developers.kakao.com)
# Activate Kakao Map API on the FIRST app of your developer account for free quota.
KAKAO_REST_KEY=your_kakao_rest_api_key
# JavaScript key for Kakao Map WebView (client-safe with domain/package restrictions)
KAKAO_JS_KEY=your_kakao_javascript_key

# Public Data Portal - MOLIT apartment trade API (https://www.data.go.kr)
# Apply for: 국토교통부_아파트 매매 실거래가 자료 (AptTrade)
MOLIT_SERVICE_KEY=your_data_go_kr_service_key

# Server
PORT=3001
CACHE_TTL_SECONDS=21600
# Set to true to return demo data when keys are missing / API fails
ALLOW_MOCK_FALLBACK=true
